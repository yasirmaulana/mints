{
  "framework": "nuxtjs",
  "headers": [
    {
      "source": "/api/products(.*)",
      "headers": [{ "key": "Vary", "value": "Accept-Encoding" }]
    },
    {
      "source": "/api/categories(.*)",
      "headers": [{ "key": "Vary", "value": "Accept-Encoding" }]
    }
  ],
  "crons": [
    { "path": "/api/cron/store-expiry", "schedule": "0 1 * * *" },
    { "path": "/api/cron/cleanup-media", "schedule": "30 1 * * *" },
    { "path": "/api/cron/reconcile-counters", "schedule": "0 2 * * *" }
  ]
}
