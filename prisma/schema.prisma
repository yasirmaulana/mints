datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProductStatus {
  AVAILABLE
  SOLD_OUT
}

enum ProductType {
  REGULAR
  PRE_ORDER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderSource {
  FLASH_SALE
  OFFLINE
  REGULAR
}

enum PlanTier {
  FREE
  PREMIUM
  GOLD
  PLATINUM
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  EXPIRED
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model FlashSaleConfig {
  id        String    @id @default(uuid())
  title     String    @default("Flash Sale Special")
  startTime DateTime
  endTime   DateTime
  isActive  Boolean   @default(true)
  // storeId nullable: null = sesi flash sale legacy milik platform (kompatibilitas data lama)
  storeId   String?
  store     Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storeId])
}

model Product {
  id                 String           @id @default(uuid())
  title              String
  description        String?
  price              Decimal          @db.Decimal(12, 2)
  originalPrice      Decimal?         @db.Decimal(12, 2)
  imageUrl           String
  images             String[]
  videoUrl           String?
  status             ProductStatus    @default(AVAILABLE)
  productType        ProductType      @default(REGULAR)
  categoryId         String?
  category           Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  weight             Int?
  material           String?
  estimatedReadyDate DateTime?
  sessionId          String?
  session            FlashSaleConfig? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // storeId sementara nullable selama migrasi backfill (lihat prisma/seed-multi-toko.js),
  // lalu diwajibkan (NOT NULL) setelah backfill selesai — lihat catatan migrasi PRD §5.3
  storeId            String?
  store              Store?           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants           ProductVariant[]
  orders             Order[]
  media              StoreMedia[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([storeId])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size])
}

model WaTemplate {
  key       String   @id
  template  String
  updatedAt DateTime @updatedAt
}

model Buyer {
  id        String    @id @default(uuid())
  name      String
  email     String?   @unique
  phone     String?   @unique
  password  String?
  gender    String?
  birthDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orders    Order[]
  stores    Store[]
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Order {
  id               String      @id @default(uuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  qty              Int         @default(1)
  buyerId          String?
  buyer            Buyer?      @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName        String
  buyerPhone       String
  paymentProof     String?
  status           OrderStatus @default(PENDING_PAYMENT)
  source           OrderSource @default(FLASH_SALE)
  notifyCount      Int         @default(0)
  lastNotifiedAt   DateTime?
  // Checkout fields (used for REGULAR orders)
  address          String?
  cityId           String?
  cityName         String?
  courierCode      String?
  courierService   String?
  shippingCost     Int?
  voucherCode      String?
  discountAmount   Int?
  // storeId sementara nullable selama migrasi backfill — lihat catatan migrasi PRD §5.3
  storeId          String?
  store            Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  commissionAmount Int?
  payoutStatus     String      @default("PENDING")
  payment          Payment?
  shipment         Shipment?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([buyerId])
  @@index([storeId])
}

model Payment {
  id              String    @id @default(uuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Tidak lagi @unique: checkout lintas toko membuat satu transaksi Duitku yang dibagi ke
  // beberapa Order (satu per toko), sehingga beberapa Payment berbagi duitkuReference yang sama
  // (PRD §11 Fase 5 "satu pembayaran → beberapa order").
  duitkuReference String
  paymentUrl      String?
  paymentMethod   String?
  vaNumber        String?
  qrString        String?
  status          String    @default("pending")
  paidAt          DateTime?
  expiredAt       DateTime?
  rawCallback     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([duitkuReference])
}

model Shipment {
  id          String    @id @default(uuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier     String
  trackingNo  String
  status      String    @default("WAITING_PICKUP")
  lastChecked DateTime?
  rawTracking Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StoreSettings {
  key   String @id
  value String
}

model ChatSession {
  id         String        @id @default(uuid())
  buyerPhone String
  buyerName  String
  productId  String?
  orderId    String?
  // null = chat lama sebelum multi-toko, diarahkan ke admin platform
  storeId    String?
  isRead     Boolean       @default(false)
  messages   ChatMessage[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([storeId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String
  body      String
  createdAt DateTime    @default(now())
}

/// Definisi paket langganan toko — diubah admin lewat dashboard tanpa deploy ulang.
/// Batasan bernilai null berarti tidak terbatas.
model Plan {
  id                    String         @id @default(uuid())
  tier                  PlanTier       @unique
  name                  String
  priceMonthly          Int // Rupiah; 0 untuk FREE. NILAI SEMENTARA — lihat PRD §14 pertanyaan terbuka.
  durationDays          Int            @default(30)
  maxStores             Int?
  maxProducts           Int?
  maxImagesPerProduct   Int?
  maxVideosPerProduct   Int?
  maxImageSizeMb        Int?
  maxVideoSizeMb        Int?
  maxVideoDurationSec   Int?
  maxStorageMb          Int?
  maxVariantsPerProduct Int?
  maxFlashSaleSessions  Int?
  commissionPercent     Decimal        @db.Decimal(5, 2)
  hasCustomDomain       Boolean        @default(false)
  hasVerifiedBadge      Boolean        @default(false)
  searchPriority        Int            @default(0)
  isActive              Boolean        @default(true)
  stores                Store[]
  subscriptions         Subscription[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Store {
  id            String            @id @default(uuid())
  ownerId       String
  owner         Buyer             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  slug          String            @unique
  description   String?
  logoUrl       String?
  bannerUrl     String?
  phone         String
  address       String?
  cityId        String?
  cityName      String?
  status        StoreStatus       @default(DRAFT)
  rejectReason  String?
  planId        String
  plan          Plan              @relation(fields: [planId], references: [id])
  expiresAt     DateTime
  // Counter terdenormalisasi — sumber kebenaran untuk pengecekan kuota (lihat server/utils/plan-limits.ts)
  productCount  Int               @default(0)
  storageUsedKb Int               @default(0)
  products      Product[]
  orders        Order[]
  flashSales    FlashSaleConfig[]
  media         StoreMedia[]
  subscriptions Subscription[]
  vouchers      Voucher[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([ownerId])
  @@index([status, expiresAt])
}

model Voucher {
  id             String    @id @default(uuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code           String
  discountAmount Int
  minPurchase    Int       @default(0)
  quota          Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([storeId, code])
  @@index([storeId])
}

/// Catatan setiap file yang diunggah penjual — dipakai untuk menghitung kuota storage
/// dan menghapus objek S3 saat produk/toko dihapus. Diisi mulai Fase 3 (upload media toko).
model StoreMedia {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind        String // "IMAGE" | "VIDEO"
  s3Key       String   @unique
  url         String
  sizeKb      Int
  durationSec Int?
  mimeType    String
  createdAt   DateTime @default(now())

  @@index([storeId])
  @@index([productId])
}

model Subscription {
  id              String             @id @default(uuid())
  storeId         String
  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(PENDING_PAYMENT)
  amount          Int
  periodStart     DateTime
  periodEnd       DateTime
  duitkuReference String?            @unique
  paymentUrl      String?
  paidAt          DateTime?
  rawCallback     Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([storeId])
}
