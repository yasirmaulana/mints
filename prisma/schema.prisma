datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProductStatus {
  AVAILABLE
  SOLD_OUT
}

enum ProductType {
  REGULAR
  PRE_ORDER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderSource {
  FLASH_SALE
  OFFLINE
  REGULAR
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model FlashSaleConfig {
  id        String    @id @default(uuid())
  title     String    @default("Flash Sale Special")
  startTime DateTime
  endTime   DateTime
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                 String           @id @default(uuid())
  title              String
  description        String?
  price              Decimal          @db.Decimal(12, 2)
  originalPrice      Decimal?         @db.Decimal(12, 2)
  imageUrl           String
  images             String[]
  status             ProductStatus    @default(AVAILABLE)
  productType        ProductType      @default(REGULAR)
  categoryId         String?
  category           Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  weight             Int?
  material           String?
  estimatedReadyDate DateTime?
  sessionId          String?
  session            FlashSaleConfig? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  orders             Order[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size])
}

model WaTemplate {
  key       String   @id
  template  String
  updatedAt DateTime @updatedAt
}

model Buyer {
  id        String    @id @default(uuid())
  name      String
  email     String?   @unique
  phone     String    @unique
  password  String
  gender    String?
  birthDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orders    Order[]
}

model Order {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  qty            Int         @default(1)
  buyerId        String?
  buyer          Buyer?      @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName      String
  buyerPhone     String
  paymentProof   String?
  status         OrderStatus @default(PENDING_PAYMENT)
  source         OrderSource @default(FLASH_SALE)
  notifyCount    Int         @default(0)
  lastNotifiedAt DateTime?
  // Checkout fields (used for REGULAR orders)
  address        String?
  cityId         String?
  cityName       String?
  courierCode    String?
  courierService String?
  shippingCost   Int?
  payment        Payment?
  shipment       Shipment?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([buyerId])
}

model Payment {
  id              String    @id @default(uuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  duitkuReference String    @unique
  paymentUrl      String?
  paymentMethod   String?
  vaNumber        String?
  status          String    @default("pending")
  paidAt          DateTime?
  expiredAt       DateTime?
  rawCallback     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Shipment {
  id          String    @id @default(uuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier     String
  trackingNo  String
  status      String    @default("WAITING_PICKUP")
  lastChecked DateTime?
  rawTracking Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StoreSettings {
  key   String @id
  value String
}

model ChatSession {
  id         String        @id @default(uuid())
  buyerPhone String
  buyerName  String
  productId  String?
  orderId    String?
  isRead     Boolean       @default(false)
  messages   ChatMessage[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String
  body      String
  createdAt DateTime    @default(now())
}
